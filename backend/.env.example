# Database
DATABASE_URL=postgresql://user:password@localhost:5432/juventud_guacarhue

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# API
PORT=3000
NODE_ENV=development

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Storage (Cloudflare R2 - bucket publico de las imagenes del panel)
#
# Paso a paso del bucket en docs/DEPLOY.md (seccion "Cloudflare R2").
#   1. Crea el bucket (ej. juventud-guacarhue-fotos) y dale una URL publica:
#      Settings -> Public access -> Custom Domains (ej. https://fotos.tudominio.cl)
#      o el subdominio de pruebas R2.dev (https://pub-xxxx.r2.dev).
#   2. Manage R2 API Tokens -> Object Read & Write, acotado a ese bucket.
#   3. Copia Account ID, Access Key ID y Secret Access Key.
#   4. Comprueba la vuelta completa (subir, leer la URL publica y borrar):
#        npm run r2:probar
#
# Sin R2_BUCKET_IMAGENES/R2_URL_IMAGENES las imagenes se guardan en el disco
# (UPLOAD_DIR / volumen de Railway): sirve para desarrollo y como respaldo, pero
# no hay CDN y no se comparten entre replicas.
R2_BUCKET_IMAGENES=
R2_URL_IMAGENES=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional: endpoint propio (por defecto se arma con R2_ACCOUNT_ID).
# R2_ENDPOINT=

# Uploads en disco (imagenes subidas desde el panel: logo, galeria, noticias, etc.)
# Solo se usa cuando R2 no esta configurado. En local se usa
# backend/public/uploads. En Railway monta un volumen y deja que
# RAILWAY_VOLUME_MOUNT_PATH lo detecte, o define UPLOAD_DIR explicitamente.
# Sin volumen las imagenes se borran en cada redeploy (ver docs/DEPLOY.md).
# UPLOAD_DIR=/data/uploads

# CORS
# Varios origenes permitidos separados por coma. En produccion incluir el
# dominio del frontend en Vercel, por ejemplo:
# CORS_ORIGIN=https://juventud-guacarhue.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Default admin bootstrap
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NOMBRE=Admin
DEFAULT_ADMIN_APELLIDO=Juventud
