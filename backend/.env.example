# Database
DATABASE_URL=postgresql://user:password@localhost:5432/juventud_guacarhue

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# API
PORT=3000
NODE_ENV=development

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Storage (AWS S3 o Cloudflare R2)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# CORS
# Varios origenes permitidos separados por coma. En produccion incluir el
# dominio del frontend en Vercel, por ejemplo:
# CORS_ORIGIN=https://juventud-guacarhue.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Default admin bootstrap
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NOMBRE=Admin
DEFAULT_ADMIN_APELLIDO=Juventud
