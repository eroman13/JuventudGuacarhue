{
  "name": "juventud-guacarhue-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST para Juventud Guacarhue - Club deportivo con panel administrativo",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --skipLibCheck",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:estado": "prisma migrate status",
    "db:seed": "tsx scripts/seed.ts",
    "db:superadmin": "tsx scripts/create-superadmin.ts",
    "lint": "eslint src --ext ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.1.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.10",
    "@types/express": "^4.17.22",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.4",
    "@types/uuid": "^10.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.56.0",
    "prisma": "^5.22.0",
    "tsx": "^4.17.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
