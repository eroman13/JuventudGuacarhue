{
  "name": "juventud-guacarhue-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST para Juventud Guacarhue - Club deportivo con panel administrativo",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --skipLibCheck",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:estado": "prisma migrate status",
    "r2:probar": "tsx scripts/probar-r2.ts",
    "lint": "eslint src --ext ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@prisma/client": "5.7.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-async-errors": "3.1.1",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "1.4.11",
    "@types/node": "20.10.5",
    "@types/uuid": "9.0.7",
    "@typescript-eslint/eslint-plugin": "6.15.0",
    "@typescript-eslint/parser": "6.15.0",
    "eslint": "8.56.0",
    "prisma": "5.7.1",
    "tsx": "4.7.0",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
