# Desarrollo local (Vite hace proxy de /api hacia http://localhost:3000)
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=Juventud Guacarhue
# Opcional: numero WhatsApp para pedidos rapidos (solo digitos, ej: 56912345678)
VITE_TIENDA_WHATSAPP=

# Produccion (Vercel): definir esta variable en el panel de Vercel con la URL
# publica del backend en Railway, siempre terminando en /api:
# VITE_API_URL=https://juventud-guacarhue-production.up.railway.app/api
